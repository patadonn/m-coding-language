using System;
using System.Collections.Generic;
using System.Linq;

namespace MESCL
{
    // Узлы AST (Abstract Syntax Tree)
    public abstract class АстУзел { }

    public class Программа : АстУзел
    {
        public List<АстУзел> Операторы { get; set; } = new();
    }

    public class ОбъявлениеПеременной : АстУзел
    {
        public string Имя { get; set; }
        public АстУзел Инициализатор { get; set; }
    }

    public class БлокЕсли : АстУзел
    {
        public АстУзел Условие { get; set; }
        public List<АстУзел> ТелоЕсли { get; set; } = new();
        public List<АстУзел> ТелоИначе { get; set; }
    }

    public class ВызовФункции : АстУзел
    {
        public string ИмяФункции { get; set; }
        public List<АстУзел> Аргументы { get; set; } = new();
    }

    public class БинарнаяОперация : АстУзел
    {
        public АстУзел Левый { get; set; }
        public string Оператор { get; set; }
        public АстУзел Правый { get; set; }
    }

    public class ЛитеральЧисло : АстУзел
    {
        public int Значение { get; set; }
    }

    public class ЛитеральСтрока : АстУзел
    {
        public string Значение { get; set; }
    }

    public class Идентификатор : АстУзел
    {
        public string Имя { get; set; }
    }

    public class Присваивание : АстУзел
    {
        public string Переменная { get; set; }
        public АстУзел Значение { get; set; }
    }

    public class Parser
    {
        private List<Dictionary<string, (Tokenizator.ТипТокена, string)>> токены;
        private int текущаяПозиция;

        public Parser(List<Dictionary<string, (Tokenizator.ТипТокена, string)>> входныеТокены)
        {
            токены = входныеТокены;
            текущаяПозиция = 0;
        }

        public Программа Парсить()
        {
            var программа = new Программа();

            while (!КонецПотока())
            {
                // Пропускаем переносы
                if (ТекущийТип() == Tokenizator.ТипТокена.Перенос)
                {
                    Следующий();
                    continue;
                }

                var оператор = ПарситьОператор();
                if (оператор != null)
                {
                    программа.Операторы.Add(оператор);
                }
            }

            return программа;
        }

        private АстУзел ПарситьОператор()
        {
            if (КонецПотока())
                return null;

            var тип = ТекущийТип();
            var значение = ТекущееЗначение();

            switch (значение)
            {
                case "переменная":
                    return ПарситьОбъявлениеПеременной();
                case "если":
                    return ПарситьБлокЕсли();
                default:
                    return ПарситьПросторвыражение();
            }
        }

        private АстУзел ПарситьОбъявлениеПеременной()
        {
            // переменная А = 54;
            Ожидать("переменная");

            var имя = ОжидатьИдентификатор();

            if (ТекущийТип() == Tokenizator.ТипТокена.Присвоить)
            {
                Следующий();
                var инициализатор = ПарситьВыражение();

                ОжидатьТип(Tokenizator.ТипТокена.ДелительФункции); // ;

                return new ОбъявлениеПеременной
                {
                    Имя = имя,
                    Инициализатор = инициализатор
                };
            }

            throw new Exception($"Ожидается '=' после объявления переменной {имя}");
        }

        private АстУзел ПарситьБлокЕсли()
        {
            // если (А == 54) $ ... #
            Ожидать("если");

            ОжидатьТип(Tokenizator.ТипТокена.СОТкр); // (
            var условие = ПарситьВыражение();
            ОжидатьТип(Tokenizator.ТипТокена.СЗакр); // )

            ОжидатьТип(Tokenizator.ТипТокена.Действия); // $

            var телоЕсли = ПарситьБлок();

            ОжидатьТип(Tokenizator.ТипТокена.КонецДействий); // #

            return new БлокЕсли
            {
                Условие = условие,
                ТелоЕсли = телоЕсли
            };
        }

        private List<АстУзел> ПарситьБлок()
        {
            var операторы = new List<АстУзел>();

            while (ТекущийТип() != Tokenizator.ТипТокена.КонецДействий && !КонецПотока())
            {
                if (ТекущийТип() == Tokenizator.ТипТокена.Перенос)
                {
                    Следующий();
                    continue;
                }

                var оператор = ПарситьОператор();
                if (оператор != null)
                {
                    операторы.Add(оператор);
                }
            }

            return операторы;
        }

        private АстУзел ПарситьПросторвыражение()
        {
            // Может быть вызов функции, присваивание или просто выражение
            var значение = ТекущееЗначение();

            if (ТекущийТип() == Tokenizator.ТипТокена.Идентификатор)
            {
                var имя = значение;
                Следующий();

                // Проверяем, это присваивание или вызов функции
                if (ТекущийТип() == Tokenizator.ТипТокена.Присвоить)
                {
                    Следующий();
                    var значениеПрис = ПарситьВыражение();
                    ОжидатьТип(Tokenizator.ТипТокена.ДелительФункции); // ;
                    return new Присваивание { Переменная = имя, Значение = значениеПрис };
                }
                else if (ТекущийТип() == Tokenizator.ТипТокена.СОТкр)
                {
                    // Вызов функции
                    Следующий();
                    var аргументы = ПарситьАргументы();
                    ОжидатьТип(Tokenizator.ТипТокена.СЗакр);
                    ОжидатьТип(Tokenizator.ТипТокена.ДелительФункции); // ;
                    return new ВызовФункции { ИмяФункции = имя, Аргументы = аргументы };
                }
                else if (ТекущийТип() == Tokenizator.ТипТокена.ВстройФункция)
                {
                    // Встроенная функция
                    var функция = значение;
                    if (функция == "отладить")
                    {
                        Следующий();
                        ОжидатьТип(Tokenizator.ТипТокена.СОТкр);
                        var аргументы = ПарситьАргументы();
                        ОжидатьТип(Tokenizator.ТипТокена.СЗакр);
                        ОжидатьТип(Tokenizator.ТипТокена.ДелительФункции);
                        return new ВызовФункции { ИмяФункции = функция, Аргументы = аргументы };
                    }
                }
            }
            else if (ТекущийТип() == Tokenizator.ТипТокена.ВстройФункция)
            {
                // Встроенная функция напрямую
                var функция = значение;
                Следующий();
                ОжидатьТип(Tokenizator.ТипТокена.СОТкр);
                var аргументы = ПарситьАргументы();
                ОжидатьТип(Tokenizator.ТипТокена.СЗакр);
                ОжидатьТип(Tokenizator.ТипТокена.ДелительФункции);
                return new ВызовФункции { ИмяФункции = функция, Аргументы = аргументы };
            }

            throw new Exception($"Неожиданный токен: {значение}");
        }

        private АстУзел ПарситьВыражение()
        {
            return ПарситьСравнение();
        }

        private АстУзел ПарситьСравнение()
        {
            var левый = ПарситьАрифметика();

            while (ТекущийТип() == Tokenizator.ТипТокена.Равно)
            {
                var опер = ТекущееЗначение();
                Следующий();
                var правый = ПарситьАрифметика();
                левый = new БинарнаяОперация { Левый = левый, Оператор = опер, Правый = правый };
            }

            return левый;
        }

        private АстУзел ПарситьАрифметика()
        {
            var левый = ПарситьПервичное();

            while (ТекущийТип() == Tokenizator.ТипТокена.Плюс ||
                   ТекущийТип() == Tokenizator.ТипТокена.Минус ||
                   ТекущийТип() == Tokenizator.ТипТокена.Умножить ||
                   ТекущийТип() == Tokenizator.ТипТокена.Делить)
            {
                var опер = ТекущееЗначение();
                Следующий();
                var правый = ПарситьПервичное();
                левый = new БинарнаяОперация { Левый = левый, Оператор = опер, Правый = правый };
            }

            return левый;
        }

        private АстУзел ПарситьПервичное()
        {
            var тип = ТекущийТип();
            var значение = ТекущееЗначение();

            if (тип == Tokenizator.ТипТокена.Номер)
            {
                Следующий();
                return new ЛитеральЧисло { Значение = int.Parse(значение) };
            }
            else if (тип == Tokenizator.ТипТокена.Строка)
            {
                Следующий();
                return new ЛитеральСтрока { Значение = значение };
            }
            else if (тип == Tokenizator.ТипТокена.Идентификатор)
            {
                Следующий();
                return new Идентификатор { Имя = значение };
            }
            else if (тип == Tokenizator.ТипТокена.СОТкр)
            {
                Следующий();
                var выражение = ПарситьВыражение();
                ОжидатьТип(Tokenizator.ТипТокена.СЗакр);
                return выражение;
            }

            throw new Exception($"Неожиданный токен в выражении: {значение}");
        }

        private List<АстУзел> ПарситьАргументы()
        {
            var аргументы = new List<АстУзел>();

            while (ТекущийТип() != Tokenizator.ТипТокена.СЗакр && !КонецПотока())
            {
                аргументы.Add(ПарситьВыражение());

                if (ТекущийТип() == Tokenizator.ТипТокена.Запятая)
                {
                    Следующий();
                }
                else
                {
                    break;
                }
            }

            return аргументы;
        }

        private void Ожидать(string ожидаемоеЗначение)
        {
            if (ТекущееЗначение() != ожидаемоеЗначение)
            {
                throw new Exception($"Ожидалось '{ожидаемоеЗначение}', но получено '{ТекущееЗначение()}'");
            }
            Следующий();
        }

        private string ОжидатьИдентификатор()
        {
            if (ТекущийТип() != Tokenizator.ТипТокена.Идентификатор)
            {
                throw new Exception($"Ожидается идентификатор, но получено '{ТекущееЗначение()}'");
            }
            var значение = ТекущееЗначение();
            Следующий();
            return значение;
        }

        private void ОжидатьТип(Tokenizator.ТипТокена ожидаемыйТип)
        {
            if (ТекущийТип() != ожидаемыйТип)
            {
                throw new Exception($"Ожидается {ожидаемыйТип}, но получено {ТекущийТип()}");
            }
            Следующий();
        }

        private Tokenizator.ТипТокена ТекущийТип()
        {
            if (КонецПотока())
                return Tokenizator.ТипТокена.Перенос;

            var токен = токены[текущаяПозиция];
            return токен["токен"].Item1;
        }

        private string ТекущееЗначение()
        {
            if (КонецПотока())
                return string.Empty;

            var токен = токены[текущаяПозиция];
            return токен["токен"].Item2;
        }

        private void Следующий()
        {
            if (!КонецПотока())
            {
                текущаяПозиция++;
            }
        }

        private bool КонецПотока()
        {
            return текущаяПозиция >= токены.Count;
        }
    }
}
