using System;
using System.Collections.Generic;
using System.Linq;

namespace MESCL
{
    public class Parser
    {
        private readonly List<(Tokenizator.ТипТокена тип, string значение)> _tokens;
        private int _pos = 0;

        public Parser(List<Dictionary<string, (Tokenizator.ТипТокена, string)>> rawTokens)
        {
            // Преобразуем в плоский список токенов
            _tokens = rawTokens.SelectMany(d => d.Values).Select(v => (v.Item1, v.Item2)).ToList();
        }

        private (Tokenizator.ТипТокена, string) Current => _pos < _tokens.Count ? _tokens[_pos] : (default, string.Empty);
        private bool IsAtEnd => _pos >= _tokens.Count;

        private (Tokenizator.ТипТокена, string) Peek(int ahead = 1)
        {
            int idx = _pos + ahead;
            return idx < _tokens.Count ? _tokens[idx] : (default, string.Empty);
        }

        private (Tokenizator.ТипТокена, string) Advance()
        {
            var cur = Current;
            _pos++;
            return cur;
        }

        private bool Match(Tokenizator.ТипТокена тип)
        {
            if (IsAtEnd) return false;
            if (Current.Item1 == тип)
            {
                Advance();
                return true;
            }
            return false;
        }

        private void SkipNewlines()
        {
            while (!IsAtEnd && Current.Item1 == Tokenizator.ТипТокена.Перенос) Advance();
        }

        public ProgramNode ParseProgram()
        {
            var program = new ProgramNode();
            SkipNewlines();
            while (!IsAtEnd)
            {
                var stmt = ParseStatement();
                if (stmt != null) program.Statements.Add(stmt);
                SkipNewlines();
            }
            return program;
        }

        private AstNode? ParseStatement()
        {
            if (IsAtEnd) return null;

            var (тип, значение) = Current;

            // Пропускаем переносы
            if (тип == Tokenizator.ТипТокена.Перенос)
            {
                Advance();
                return null;
            }

            if (тип == Tokenizator.ТипТокена.КодСлово)
            {
                if (значение == "переменная")
                {
                    return ParseVarDeclaration();
                }
                else if (значение == "если")
                {
                    return ParseIf();
                }
                else if (значение == "иначе")
                {
                    // Парсим блок else как IfNode с пустой Condition
                    Advance(); // consume 'иначе'
                    var node = new IfNode();
                    ParseActionsInto(node.ElseBranch);
                    return node;
                }
            }

            // Вызов функции или присвоение / выражение
            if (тип == Tokenizator.ТипТокена.Идентификатор || тип == Tokenizator.ТипТокена.КодСлово)
            {
                // Сохраним имя
                var name = значение;
                Advance();

                // Функция: следующий токен = СОТКР '('
                if (!IsAtEnd && Current.Item1 == Tokenizator.ТипТокена.СОТКР)
                {
                    var call = new FunctionCallNode { Name = name };
                    Advance(); // (
                    // аргументы
                    SkipNewlines();
                    while (!IsAtEnd && Current.Item1 != Tokenizator.ТипТокена.СЗАКР)
                    {
                        var expr = ParseExpression();
                        if (expr != null) call.Arguments.Add(expr);
                        if (Current.Item1 == Tokenizator.ТипТокена.Запятая) Advance();
                        else break;
                    }
                    // закрывающая скобка
                    if (Current.Item1 == Tokenizator.ТипТокена.СЗАКР) Advance();
                    // optional ';'
                    if (Current.Item1 == Tokenizator.ТипТокена.ДелительФункции) Advance();
                    return call;
                }

                // Присвоение: если после имени стоит Присвоить
                if (Current.Item1 == Tokenizator.ТипТокена.Присвоить)
                {
                    Advance();
                    var assign = new AssignmentNode { Target = name };
                    assign.Value = ParseExpression();
                    if (Current.Item1 == Tokenizator.ТипТокена.ДелительФункции) Advance();
                    return assign;
                }

                // Иначе — простая идентификаторная инструкция (например, метка)
                if (Current.Item1 == Tokenizator.ТипТокена.ДелительФункции) Advance();
                return new FunctionCallNode { Name = name };
            }

            // Если не распознали — просто пропустить токен
            Advance();
            return null;
        }

        private VarDeclarationNode ParseVarDeclaration()
        {
            // current = 'переменная'
            Advance();
            var node = new VarDeclarationNode();

            // имена через запятую
            while (!IsAtEnd)
            {
                if (Current.Item1 == Tokenizator.ТипТокена.Идентификатор || Current.Item1 == Tokenizator.ТипТокена.КодСлово)
                {
                    node.Names.Add(Current.Item2);
                    Advance();
                }
                else
                {
                    break;
                }

                if (Current.Item1 == Tokenizator.ТипТокена.Запятая)
                {
                    Advance();
                    continue;
                }
                else break;
            }

            // optional assignment
            if (Current.Item1 == Tokenizator.ТипТокена.Присвоить)
            {
                Advance();
                node.Initializer = ParseExpression();
            }

            if (Current.Item1 == Tokenizator.ТипТокена.ДелительФункции) Advance();

            return node;
        }

        private IfNode ParseIf()
        {
            Advance(); // consume 'если'
            var node = new IfNode();

            // пропускаем возможное ключевое слово 'переменная' после 'если'
            if (Current.Item1 == Tokenizator.ТипТокена.КодСлово && Current.Item2 == "переменная") Advance();

            // возможно скобки
            if (Current.Item1 == Tokenizator.ТипТокена.СОТКР) Advance();
            node.Condition = ParseExpression();
            if (Current.Item1 == Tokenizator.ТипТокена.СЗАКР) Advance();

            // ожидаем Действия токен ($)
            if (Current.Item1 == Tokenizator.ТипТокена.Действия) Advance();
            ParseActionsInto(node.ThenBranch);

            // после then может идти 'иначе'
            if (!IsAtEnd && Current.Item1 == Tokenizator.ТипТокена.КодСлово && Current.Item2 == "иначе")
            {
                Advance();
                if (Current.Item1 == Tokenizator.ТипТокена.Действия) Advance();
                ParseActionsInto(node.ElseBranch);
            }

            return node;
        }

        private void ParseActionsInto(List<AstNode> target)
        {
            // Парсим инструкции до КонецДействий (#)
            while (!IsAtEnd && Current.Item1 != Tokenizator.ТипТокена.КонецДействий)
            {
                var stmt = ParseStatement();
                if (stmt != null) target.Add(stmt);
            }
            if (Current.Item1 == Tokenizator.ТипТокена.КонецДействий) Advance();
        }

        private ExpressionNode? ParseExpression()
        {
            var left = ParsePrimary();
            if (left == null) return null;

            // простая поддержка бинарной операции с одним оператором
            if (!IsAtEnd)
            {
                var (тип, значение) = Current;
                string? op = null;
                if (тип == Tokenizator.ТипТокена.Плюс) op = "+";
                else if (тип == Tokenizator.ТипТокена.Минус) op = "-";
                else if (тип == Tokenizator.ТипТокена.Множить) op = "*";
                else if (тип == Tokenizator.ТипТокена.Делить) op = "/";
                else if (тип == Tokenizator.ТипТокена.Равно) op = "==";

                if (op != null)
                {
                    Advance();
                    var right = ParseExpression() ?? new IdentifierNode { Name = string.Empty };
                    return new BinaryExpressionNode { Left = left, Operator = op, Right = right };
                }
            }

            return left;
        }

        private ExpressionNode? ParsePrimary()
        {
            if (IsAtEnd) return null;
            var (тип, значение) = Current;

            if (тип == Tokenizator.ТипТокена.Номер)
            {
                Advance();
                // Собирать возможные дробные части через точку
                string raw = значение;
                if (Current.Item1 == Tokenizator.ТипТокена.Точка)
                {
                    Advance();
                    if (Current.Item1 == Tokenizator.ТипТокена.Номер)
                    {
                        raw += "." + Current.Item2;
                        Advance();
                    }
                }
                return new NumberNode { Value = raw };
            }

            if (тип == Tokenizator.ТипТокена.Строка)
            {
                Advance();
                return new StringNode { Value = значение };
            }

            if (тип == Tokenizator.ТипТокена.Идентификатор || тип == Tokenizator.ТипТокена.КодСлово)
            {
                Advance();
                return new IdentifierNode { Name = значение };
            }

            if (тип == Tokenizator.ТипТокена.СОТКР)
            {
                Advance();
                var expr = ParseExpression();
                if (Current.Item1 == Tokenizator.ТипТокена.СЗАКР) Advance();
                return expr;
            }

            return null;
        }
    }
}
